@using SaaSInventoryManagement.ViewModels.Supplier
@model List<SupplierListItemVm>
@{
    ViewData["Title"] = "Suppliers";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0">Suppliers</h1>
    @if (User.HasClaim("perm", "*") || User.HasClaim("perm", "inv.suppliers.manage"))
    {
        <a class="btn btn-primary" asp-controller="Supplier" asp-action="Create">
            <i class="fa-solid fa-plus me-1"></i> New Supplier
        </a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Contact</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="text-muted text-center py-4">No suppliers yet.</td></tr>
                }
                @foreach (var supplier in Model)
                {
                    <tr>
                        <td class="fw-semibold">@supplier.Name</td>
                        <td class="text-muted">@(string.IsNullOrWhiteSpace(supplier.ContactPerson) ? "—" : supplier.ContactPerson)</td>
                        <td class="text-muted">@(string.IsNullOrWhiteSpace(supplier.Email) ? "—" : supplier.Email)</td>
                        <td class="text-muted">@(string.IsNullOrWhiteSpace(supplier.Phone) ? "—" : supplier.Phone)</td>
                        <td>
                            @if (supplier.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (User.HasClaim("perm", "*") || User.HasClaim("perm", "inv.suppliers.manage"))
                            {
                                <a class="btn btn-sm btn-outline-secondary" asp-controller="Supplier" asp-action="Edit" asp-route-id="@supplier.Id">
                                    <i class="fa-solid fa-pen"></i> Edit
                                </a>
                                <form asp-controller="Supplier" asp-action="Delete" asp-route-id="@supplier.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete supplier \'@supplier.Name\'?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="fa-solid fa-trash"></i> Delete
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

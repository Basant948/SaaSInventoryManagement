@using SaaSInventoryManagement.ViewModels.Product
@model List<ProductListItemVm>
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0">Products</h1>
    @if (User.HasClaim("perm", "*") || User.HasClaim("perm", "inv.products.manage"))
    {
        <a class="btn btn-primary" asp-controller="Product" asp-action="Create">
            <i class="fa-solid fa-plus me-1"></i> New Product
        </a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th></th>
                    <th>Name</th>
                    <th>SKU</th>
                    <th>Category</th>
                    <th>Unit</th>
                    <th class="text-end">Cost Price</th>
                    <th class="text-end">Selling Price</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="9" class="text-muted text-center py-4">No products yet.</td></tr>
                }
                @foreach (var product in Model)
                {
                    <tr>
                        <td style="width:56px;">
                            @if (!string.IsNullOrWhiteSpace(product.Image))
                            {
                                <img src="@product.Image" alt="@product.Name" class="rounded" style="width:40px;height:40px;object-fit:cover;" />
                            }
                            else
                            {
                                <div class="rounded bg-light d-flex align-items-center justify-content-center text-muted" style="width:40px;height:40px;">
                                    <i class="fa-solid fa-image"></i>
                                </div>
                            }
                        </td>
                        <td class="fw-semibold">@product.Name</td>
                        <td>@product.SKU</td>
                        <td class="text-muted">@(string.IsNullOrWhiteSpace(product.CategoryName) ? "—" : product.CategoryName)</td>
                        <td>@product.Unit</td>
                        <td class="text-end">@product.CostPrice.ToString("N2")</td>
                        <td class="text-end">@product.SellingPrice.ToString("N2")</td>
                        <td>
                            @if (product.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (User.HasClaim("perm", "*") || User.HasClaim("perm", "inv.products.manage"))
                            {
                                <a class="btn btn-sm btn-outline-secondary" asp-controller="Product" asp-action="Edit" asp-route-id="@product.Id">
                                    <i class="fa-solid fa-pen"></i> Edit
                                </a>
                                <form asp-controller="Product" asp-action="Delete" asp-route-id="@product.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete product \'@product.Name\'?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="fa-solid fa-trash"></i> Delete
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

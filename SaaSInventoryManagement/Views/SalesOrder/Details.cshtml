@using SaaSInventoryManagement.ViewModels.SalesOrder
@using SaaSInventoryManagement.Enums
@model SalesOrderDetailsVm
@{
    ViewData["Title"] = $"SO {Model.SoNumber}";

    string BadgeClass(SalesOrderStatus status) => status switch
    {
        SalesOrderStatus.Draft => "bg-secondary",
        SalesOrderStatus.Submitted => "bg-info text-dark",
        SalesOrderStatus.Fulfilled => "bg-success",
        SalesOrderStatus.Cancelled => "bg-danger",
        _ => "bg-light text-dark"
    };

    var canWrite = User.HasClaim("perm", "*") || User.HasClaim("perm", "inv.salesorders.create");
}

<div class="d-flex align-items-center justify-content-between mb-2">
    <h1 class="h3 mb-0">@Model.SoNumber</h1>
    <span class="badge @BadgeClass(Model.Status) fs-6">@Model.Status</span>
</div>
<p><a asp-controller="SalesOrder" asp-action="Index">&larr; Back to Sales Orders</a></p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row mb-4">
    <div class="col-md-6">
        <dl class="row mb-0">
            <dt class="col-sm-4">Customer</dt>
            <dd class="col-sm-8">@Model.CustomerName</dd>
            <dt class="col-sm-4">Warehouse</dt>
            <dd class="col-sm-8">@Model.WarehouseName</dd>
            <dt class="col-sm-4">Order Date</dt>
            <dd class="col-sm-8">@Model.OrderDate.ToString("yyyy-MM-dd")</dd>
            <dt class="col-sm-4">Requested</dt>
            <dd class="col-sm-8">@(Model.RequestedDate?.ToString("yyyy-MM-dd") ?? "—")</dd>
            @if (Model.FulfilledAt.HasValue)
            {
                <dt class="col-sm-4">Fulfilled</dt>
                <dd class="col-sm-8">@Model.FulfilledAt.Value.ToString("yyyy-MM-dd HH:mm")</dd>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <dt class="col-sm-4">Notes</dt>
                <dd class="col-sm-8">@Model.Notes</dd>
            }
        </dl>
    </div>
    <div class="col-md-6 text-md-end">
        <div class="d-flex gap-2 justify-content-md-end flex-wrap">
            @if (Model.Status == SalesOrderStatus.Draft && canWrite)
            {
                <form asp-controller="SalesOrder" asp-action="Submit" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-primary">Submit</button>
                </form>
                <form asp-controller="SalesOrder" asp-action="Cancel" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('Cancel this sales order?');">
                    <button type="submit" class="btn btn-outline-danger">Cancel</button>
                </form>
            }
            @if (Model.Status == SalesOrderStatus.Submitted && canWrite)
            {
                <form asp-controller="SalesOrder" asp-action="Fulfill" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('Fulfill all lines and reduce stock in @Model.WarehouseName?');">
                    <button type="submit" class="btn btn-success">Fulfill Order</button>
                </form>
                <form asp-controller="SalesOrder" asp-action="Cancel" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('Cancel this sales order?');">
                    <button type="submit" class="btn btn-outline-danger">Cancel</button>
                </form>
            }
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>SKU</th>
                    <th class="text-end">Ordered</th>
                    <th class="text-end">Fulfilled</th>
                    <th class="text-end">Unit Price</th>
                    <th class="text-end">Line Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td class="fw-semibold">@line.ProductName</td>
                        <td>@line.SKU</td>
                        <td class="text-end">@line.QuantityOrdered.ToString("N2") @line.Unit</td>
                        <td class="text-end">@line.QuantityFulfilled.ToString("N2")</td>
                        <td class="text-end">@line.UnitPrice.ToString("N2")</td>
                        <td class="text-end">@line.LineTotal.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="5" class="text-end">Total</th>
                    <th class="text-end">@Model.TotalAmount.ToString("N2")</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

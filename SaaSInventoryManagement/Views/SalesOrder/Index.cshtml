@using SaaSInventoryManagement.ViewModels.SalesOrder
@using SaaSInventoryManagement.Enums
@model List<SalesOrderListItemVm>
@{
    ViewData["Title"] = "Sales Orders";

    string BadgeClass(SalesOrderStatus status) => status switch
    {
        SalesOrderStatus.Draft => "bg-secondary",
        SalesOrderStatus.Submitted => "bg-info text-dark",
        SalesOrderStatus.Fulfilled => "bg-success",
        SalesOrderStatus.Cancelled => "bg-danger",
        _ => "bg-light text-dark"
    };
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0">Sales Orders</h1>
    @if (User.HasClaim("perm", "*") || User.HasClaim("perm", "inv.salesorders.create"))
    {
        <a class="btn btn-primary" asp-controller="SalesOrder" asp-action="Create">
            <i class="fa-solid fa-plus me-1"></i> New Sales Order
        </a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>SO Number</th>
                    <th>Customer</th>
                    <th>Warehouse</th>
                    <th>Status</th>
                    <th>Order Date</th>
                    <th>Requested</th>
                    <th class="text-end">Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="8" class="text-muted text-center py-4">No sales orders yet.</td></tr>
                }
                @foreach (var so in Model)
                {
                    <tr>
                        <td class="fw-semibold">@so.SoNumber</td>
                        <td>@so.CustomerName</td>
                        <td>@so.WarehouseName</td>
                        <td><span class="badge @BadgeClass(so.Status)">@so.Status</span></td>
                        <td>@so.OrderDate.ToString("yyyy-MM-dd")</td>
                        <td>@(so.RequestedDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td class="text-end">@so.TotalAmount.ToString("N2")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="SalesOrder" asp-action="Details" asp-route-id="@so.Id">
                                <i class="fa-solid fa-eye"></i> View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

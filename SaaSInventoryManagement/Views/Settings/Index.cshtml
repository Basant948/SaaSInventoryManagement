@using SaaSInventoryManagement.ViewModels.Settings
@model CompanySettingsVm
@{
    ViewData["Title"] = "Company Settings";
}

<h1 class="h3 mb-4">Company Settings</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card shadow-sm" style="max-width: 640px;">
    <div class="card-body">
        <form asp-controller="Settings" asp-action="Index" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" autofocus />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label>Slug</label>
                <input value="@Model.Slug" class="form-control" disabled />
                <div class="form-text">Used internally to identify your tenant - contact support to change it.</div>
            </div>

            <hr class="my-4" />
            <h6 class="text-muted mb-3">Contact Info</h6>

            <div class="form-group mb-3">
                <label asp-for="ContactEmail"></label>
                <input asp-for="ContactEmail" class="form-control" placeholder="billing@yourcompany.com" />
                <span asp-validation-for="ContactEmail" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ContactPhone"></label>
                <input asp-for="ContactPhone" class="form-control" placeholder="+1 555 000 0000" />
                <span asp-validation-for="ContactPhone" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Address"></label>
                <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <hr class="my-4" />
            <h6 class="text-muted mb-3">Inventory Defaults</h6>

            <div class="row">
                <div class="col-sm-5 form-group mb-3">
                    <label asp-for="Currency"></label>
                    <input asp-for="Currency" class="form-control text-uppercase" maxlength="3" style="text-transform: uppercase;" />
                    <span asp-validation-for="Currency" class="text-danger"></span>
                </div>
                <div class="col-sm-7 form-group mb-3">
                    <label asp-for="LowStockThreshold"></label>
                    <input asp-for="LowStockThreshold" class="form-control" type="number" step="0.001" min="0" />
                    <span asp-validation-for="LowStockThreshold" class="text-danger"></span>
                    <div class="form-text">Stock Report flags a line as low stock at or below this quantity.</div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>

@using SaaSInventoryManagement.ViewModels.Stock
@model List<StockLedgerItemVm>
@{
    ViewData["Title"] = "Stock History";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0">Stock Movement History</h1>
    <a class="btn btn-outline-secondary" asp-controller="Stock" asp-action="Index">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Levels
    </a>
</div>

<p class="text-muted">Most recent 200 movements, newest first.</p>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Product</th>
                    <th>Warehouse</th>
                    <th>Type</th>
                    <th class="text-end">Change</th>
                    <th class="text-end">Balance</th>
                    <th>Reference</th>
                    <th>By</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="8" class="text-muted text-center py-4">No stock movements yet.</td></tr>
                }
                @foreach (var entry in Model)
                {
                    <tr>
                        <td class="text-nowrap">@entry.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@entry.ProductName <span class="text-muted">(@entry.SKU)</span></td>
                        <td>@entry.WarehouseName</td>
                        <td><span class="badge bg-light text-dark border">@entry.MovementType</span></td>
                        <td class="text-end @(entry.QuantityChange < 0 ? "text-danger" : "text-success") fw-semibold">
                            @(entry.QuantityChange > 0 ? "+" : "")@entry.QuantityChange.ToString("N2")
                        </td>
                        <td class="text-end">@entry.BalanceAfter.ToString("N2")</td>
                        <td class="text-muted">
                            @entry.ReferenceType@(entry.ReferenceId.HasValue ? $" #{entry.ReferenceId}" : "")
                            @if (!string.IsNullOrWhiteSpace(entry.Notes))
                            {
                                <br /><small>@entry.Notes</small>
                            }
                        </td>
                        <td class="text-muted">@(entry.CreatedBy ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

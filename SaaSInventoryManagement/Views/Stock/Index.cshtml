@using SaaSInventoryManagement.ViewModels.Stock
@using Microsoft.AspNetCore.Mvc.Rendering
@model List<StockLevelItemVm>
@{
    ViewData["Title"] = "Stock Levels";
    var warehouses = ViewBag.Warehouses as List<SelectListItem> ?? new();
    var selectedWarehouseId = ViewBag.SelectedWarehouseId as int?;
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <h1 class="h3 mb-0">Stock Levels</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-controller="Stock" asp-action="History">
            <i class="fa-solid fa-clock-rotate-left me-1"></i> History
        </a>
        @if (User.HasClaim("perm", "*") || User.HasClaim("perm", "inv.stock.transfer"))
        {
            <a class="btn btn-outline-primary" asp-controller="Stock" asp-action="Transfer">
                <i class="fa-solid fa-right-left me-1"></i> Transfer
            </a>
        }
        @if (User.HasClaim("perm", "*") || User.HasClaim("perm", "inv.stock.adjust"))
        {
            <a class="btn btn-primary" asp-controller="Stock" asp-action="Adjust">
                <i class="fa-solid fa-sliders me-1"></i> Adjust Stock
            </a>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="get" asp-controller="Stock" asp-action="Index" class="mb-3" style="max-width: 300px;">
    <select name="warehouseId" class="form-select" onchange="this.form.submit()">
        <option value="">All Warehouses</option>
        @foreach (var w in warehouses)
        {
            <option value="@w.Value" selected="@(selectedWarehouseId.HasValue && w.Value == selectedWarehouseId.Value.ToString())">@w.Text</option>
        }
    </select>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>SKU</th>
                    <th>Warehouse</th>
                    <th class="text-end">Quantity</th>
                    <th>Unit</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-muted text-center py-4">No stock recorded yet.</td></tr>
                }
                @foreach (var level in Model)
                {
                    <tr>
                        <td class="fw-semibold">@level.ProductName</td>
                        <td>@level.SKU</td>
                        <td>@level.WarehouseName</td>
                        <td class="text-end @(level.Quantity <= 0 ? "text-danger fw-semibold" : "")">@level.Quantity.ToString("N2")</td>
                        <td class="text-muted">@level.Unit</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@using SaaSInventoryManagement.ViewModels.PurchaseOrder
@using SaaSInventoryManagement.Enums
@model PurchaseOrderDetailsVm
@{
    ViewData["Title"] = $"PO {Model.PoNumber}";

    string BadgeClass(PurchaseOrderStatus status) => status switch
    {
        PurchaseOrderStatus.Draft => "bg-secondary",
        PurchaseOrderStatus.Submitted => "bg-info text-dark",
        PurchaseOrderStatus.Approved => "bg-primary",
        PurchaseOrderStatus.Received => "bg-success",
        PurchaseOrderStatus.Cancelled => "bg-danger",
        _ => "bg-light text-dark"
    };

    var canCreate = User.HasClaim("perm", "*") || User.HasClaim("perm", "inv.purchaseorders.create");
    var canApprove = User.HasClaim("perm", "*") || User.HasClaim("perm", "inv.purchaseorders.approve");
}

<div class="d-flex align-items-center justify-content-between mb-2">
    <h1 class="h3 mb-0">@Model.PoNumber</h1>
    <span class="badge @BadgeClass(Model.Status) fs-6">@Model.Status</span>
</div>
<p><a asp-controller="PurchaseOrder" asp-action="Index">&larr; Back to Purchase Orders</a></p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row mb-4">
    <div class="col-md-6">
        <dl class="row mb-0">
            <dt class="col-sm-4">Supplier</dt>
            <dd class="col-sm-8">@Model.SupplierName</dd>
            <dt class="col-sm-4">Warehouse</dt>
            <dd class="col-sm-8">@Model.WarehouseName</dd>
            <dt class="col-sm-4">Order Date</dt>
            <dd class="col-sm-8">@Model.OrderDate.ToString("yyyy-MM-dd")</dd>
            <dt class="col-sm-4">Expected</dt>
            <dd class="col-sm-8">@(Model.ExpectedDate?.ToString("yyyy-MM-dd") ?? "—")</dd>
            @if (Model.ReceivedAt.HasValue)
            {
                <dt class="col-sm-4">Received</dt>
                <dd class="col-sm-8">@Model.ReceivedAt.Value.ToString("yyyy-MM-dd HH:mm")</dd>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <dt class="col-sm-4">Notes</dt>
                <dd class="col-sm-8">@Model.Notes</dd>
            }
        </dl>
    </div>
    <div class="col-md-6 text-md-end">
        <div class="d-flex gap-2 justify-content-md-end flex-wrap">
            @if (Model.Status == PurchaseOrderStatus.Draft && canCreate)
            {
                <form asp-controller="PurchaseOrder" asp-action="Submit" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-primary">Submit</button>
                </form>
                <form asp-controller="PurchaseOrder" asp-action="Cancel" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('Cancel this purchase order?');">
                    <button type="submit" class="btn btn-outline-danger">Cancel</button>
                </form>
            }
            @if (Model.Status == PurchaseOrderStatus.Submitted)
            {
                @if (canApprove)
                {
                    <form asp-controller="PurchaseOrder" asp-action="Approve" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-primary">Approve</button>
                    </form>
                }
                @if (canCreate)
                {
                    <form asp-controller="PurchaseOrder" asp-action="Cancel" asp-route-id="@Model.Id" method="post"
                          onsubmit="return confirm('Cancel this purchase order?');">
                        <button type="submit" class="btn btn-outline-danger">Cancel</button>
                    </form>
                }
            }
            @if (Model.Status == PurchaseOrderStatus.Approved && canApprove)
            {
                <form asp-controller="PurchaseOrder" asp-action="Receive" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('Receive all lines and increase stock in @Model.WarehouseName?');">
                    <button type="submit" class="btn btn-success">Receive Goods</button>
                </form>
            }
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>SKU</th>
                    <th class="text-end">Ordered</th>
                    <th class="text-end">Received</th>
                    <th class="text-end">Unit Cost</th>
                    <th class="text-end">Line Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td class="fw-semibold">@line.ProductName</td>
                        <td>@line.SKU</td>
                        <td class="text-end">@line.QuantityOrdered.ToString("N2") @line.Unit</td>
                        <td class="text-end">@line.QuantityReceived.ToString("N2")</td>
                        <td class="text-end">@line.UnitCost.ToString("N2")</td>
                        <td class="text-end">@line.LineTotal.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="5" class="text-end">Total</th>
                    <th class="text-end">@Model.TotalAmount.ToString("N2")</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

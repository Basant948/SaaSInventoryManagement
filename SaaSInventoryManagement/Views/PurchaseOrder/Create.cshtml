@using SaaSInventoryManagement.ViewModels.PurchaseOrder
@model PurchaseOrderFormVm
@{
    ViewData["Title"] = "New Purchase Order";
}

<h1 class="h3 mb-4">New Purchase Order</h1>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-controller="PurchaseOrder" asp-action="Create" method="post" id="poForm">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-4 form-group mb-3">
                    <label asp-for="SupplierId"></label>
                    <select asp-for="SupplierId" asp-items="Model.Suppliers" class="form-select">
                        <option value="">-- Select a supplier --</option>
                    </select>
                    <span asp-validation-for="SupplierId" class="text-danger"></span>
                </div>
                <div class="col-md-4 form-group mb-3">
                    <label asp-for="WarehouseId"></label>
                    <select asp-for="WarehouseId" asp-items="Model.Warehouses" class="form-select">
                        <option value="">-- Select a warehouse --</option>
                    </select>
                    <span asp-validation-for="WarehouseId" class="text-danger"></span>
                </div>
                <div class="col-md-4 form-group mb-3">
                    <label asp-for="ExpectedDate"></label>
                    <input asp-for="ExpectedDate" type="date" class="form-control" />
                    <span asp-validation-for="ExpectedDate" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Notes"></label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            </div>

            <h2 class="h6">Lines</h2>
            <table class="table table-sm align-middle" id="linesTable">
                <thead>
                    <tr>
                        <th style="width:45%">Product</th>
                        <th style="width:20%">Quantity</th>
                        <th style="width:20%">Unit Cost</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="linesBody">
                    @for (var i = 0; i < Model.Lines.Count; i++)
                    {
                        <tr class="line-row">
                            <td>
                                <select name="Lines[@i].ProductId" class="form-select line-product">
                                    <option value="">-- Select a product --</option>
                                    @foreach (var p in Model.Products)
                                    {
                                        <option value="@p.Value">@p.Text</option>
                                    }
                                </select>
                            </td>
                            <td><input type="number" step="0.001" min="0" name="Lines[@i].QuantityOrdered" class="form-control" /></td>
                            <td><input type="number" step="0.01" min="0" name="Lines[@i].UnitCost" class="form-control" /></td>
                            <td><button type="button" class="btn btn-sm btn-outline-danger remove-line"><i class="fa-solid fa-xmark"></i></button></td>
                        </tr>
                    }
                </tbody>
            </table>
            <button type="button" id="addLineBtn" class="btn btn-sm btn-outline-secondary mb-4">
                <i class="fa-solid fa-plus"></i> Add Line
            </button>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create Purchase Order</button>
                <a class="btn btn-outline-secondary" asp-controller="PurchaseOrder" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            const productOptionsHtml = document.querySelector('.line-product').innerHTML;

            const productCosts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProductCosts));

            function fillCostFromProduct(row) {
                const select = row.querySelector('.line-product');
                const costInput = row.querySelector('input[name$=".UnitCost"]');
                if (!select || !costInput) return;

                if (costInput.value) return;
                const cost = productCosts[select.value];
                if (cost !== undefined) costInput.value = cost;
            }

            document.getElementById('linesBody').addEventListener('change', function(e) {
                if (e.target.classList.contains('line-product')) {
                    fillCostFromProduct(e.target.closest('.line-row'));
                }
            });

            function reindex() {
                document.querySelectorAll('#linesBody .line-row').forEach((row, index) => {
                    row.querySelectorAll('[name^="Lines["]').forEach(el => {
                        el.name = el.name.replace(/Lines\[\d+\]/, `Lines[${index}]`);
                    });
                });
            }

            document.getElementById('addLineBtn').addEventListener('click', function() {
                const tbody = document.getElementById('linesBody');
                const row = document.createElement('tr');
                row.className = 'line-row';
                row.innerHTML = `
                            <td><select name="Lines[0].ProductId" class="form-select line-product">${productOptionsHtml}</select></td>
                            <td><input type="number" step="0.001" min="0" name="Lines[0].QuantityOrdered" class="form-control" /></td>
                            <td><input type="number" step="0.01" min="0" name="Lines[0].UnitCost" class="form-control" /></td>
                            <td><button type="button" class="btn btn-sm btn-outline-danger remove-line"><i class="fa-solid fa-xmark"></i></button></td>
                        `;
                tbody.appendChild(row);
                reindex();
            });

            document.getElementById('linesBody').addEventListener('click', function(e) {
                const btn = e.target.closest('.remove-line');
                if (!btn) return;
                const rows = document.querySelectorAll('#linesBody .line-row');
                if (rows.length <= 1) return; 
                btn.closest('.line-row').remove();
                reindex();
            });
        })();
    </script>
}

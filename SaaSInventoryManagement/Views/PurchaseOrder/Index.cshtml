@using SaaSInventoryManagement.ViewModels.PurchaseOrder
@using SaaSInventoryManagement.Enums
@model List<PurchaseOrderListItemVm>
@{
    ViewData["Title"] = "Purchase Orders";

    string BadgeClass(PurchaseOrderStatus status) => status switch
    {
        PurchaseOrderStatus.Draft => "bg-secondary",
        PurchaseOrderStatus.Submitted => "bg-info text-dark",
        PurchaseOrderStatus.Approved => "bg-primary",
        PurchaseOrderStatus.Received => "bg-success",
        PurchaseOrderStatus.Cancelled => "bg-danger",
        _ => "bg-light text-dark"
    };
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0">Purchase Orders</h1>
    @if (User.HasClaim("perm", "*") || User.HasClaim("perm", "inv.purchaseorders.create"))
    {
        <a class="btn btn-primary" asp-controller="PurchaseOrder" asp-action="Create">
            <i class="fa-solid fa-plus me-1"></i> New Purchase Order
        </a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>PO Number</th>
                    <th>Supplier</th>
                    <th>Warehouse</th>
                    <th>Status</th>
                    <th>Order Date</th>
                    <th>Expected</th>
                    <th class="text-end">Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="8" class="text-muted text-center py-4">No purchase orders yet.</td></tr>
                }
                @foreach (var po in Model)
                {
                    <tr>
                        <td class="fw-semibold">@po.PoNumber</td>
                        <td>@po.SupplierName</td>
                        <td>@po.WarehouseName</td>
                        <td><span class="badge @BadgeClass(po.Status)">@po.Status</span></td>
                        <td>@po.OrderDate.ToString("yyyy-MM-dd")</td>
                        <td>@(po.ExpectedDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td class="text-end">@po.TotalAmount.ToString("N2")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="PurchaseOrder" asp-action="Details" asp-route-id="@po.Id">
                                <i class="fa-solid fa-eye"></i> View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

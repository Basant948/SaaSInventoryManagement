@using SaaSInventoryManagement.ViewModels.Warehouse
@model List<WarehouseListItemVm>
@{
    ViewData["Title"] = "Warehouses";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0">Warehouses</h1>
    @if (User.HasClaim("perm", "*") || User.HasClaim("perm", "inv.warehouses.manage"))
    {
        <a class="btn btn-primary" asp-controller="Warehouse" asp-action="Create">
            <i class="fa-solid fa-plus me-1"></i> New Warehouse
        </a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Address</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="text-muted text-center py-4">No warehouses yet.</td></tr>
                }
                @foreach (var warehouse in Model)
                {
                    <tr>
                        <td><span class="badge bg-light text-dark border">@warehouse.Code</span></td>
                        <td class="fw-semibold">@warehouse.Name</td>
                        <td class="text-muted">@(string.IsNullOrWhiteSpace(warehouse.Address) ? "—" : warehouse.Address)</td>
                        <td>
                            @if (warehouse.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>@warehouse.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">
                            @if (User.HasClaim("perm", "*") || User.HasClaim("perm", "inv.warehouses.manage"))
                            {
                                <a class="btn btn-sm btn-outline-secondary" asp-controller="Warehouse" asp-action="Edit" asp-route-id="@warehouse.Id">
                                    <i class="fa-solid fa-pen"></i> Edit
                                </a>
                                <form asp-controller="Warehouse" asp-action="Delete" asp-route-id="@warehouse.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete warehouse \'@warehouse.Name\'?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="fa-solid fa-trash"></i> Delete
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
